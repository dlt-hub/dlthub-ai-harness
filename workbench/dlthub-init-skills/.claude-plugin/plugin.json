{
  "name": "dlthub-init-skills",
  "description": "Build a minimal custom REST API pipeline and deploy it to the dltHub platform after running uvx dlthub-init. Requires dltHub Platform.",
  "version": "0.2.0",
  "author": {
    "name": "ScaleVector GmbH"
  },
  "homepage": "https://dlthub.com/docs",
  "repository": "https://github.com/dlt-hub/dlthub-ai-harness",
  "license": "https://github.com/dlt-hub/dlthub-ai-harness/blob/master/LICENSE",
  "keywords": ["dlthub"],
  "mcpServers": {
    "dlt-workspace-mcp": {
      "command": "uv",
      "args": ["run", "dlthub", "ai", "mcp", "--stdio"]
    }
  }
}
